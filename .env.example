XHS_DEBUG=false
# Local dashboard: this must point to the separately deployed API. The
# dashboard never connects to MySQL and does not provide a local fallback.
# Use HTTPS for a remote API (HTTP is allowed only for localhost development).
XHS_CONTENT_CHECKER_API_BASE=https://api.example.com/api/content-checker
DASHSCOPE_API_KEY=your-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_VISION_MODEL=qwen3.6-flash
DASHSCOPE_STRATEGY_MODEL=qwen-plus
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
# API service only: keep these values in the API server's private environment,
# never in the local dashboard .env file.
CONTENT_CHECKER_API_HOST=127.0.0.1
CONTENT_CHECKER_API_PORT=5179
CONTENT_CHECKER_ALLOWED_ORIGINS=http://localhost:5178,http://127.0.0.1:5178
