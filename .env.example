XHS_DEBUG=false
# Local dashboard: point the pre-publication pages at the deployed API.
XHS_CONTENT_CHECKER_API_BASE=http://your-server:5178/api/content-checker
DASHSCOPE_API_KEY=your-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_VISION_MODEL=qwen3.6-flash
DASHSCOPE_STRATEGY_MODEL=qwen-plus
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
# Embedded pre-publication audit features use the dashboard process and port.
# Set DATABASE_URL and ADMIN_EMAILS below when account, history, or practice-library features are enabled.
DATABASE_URL=mysql://note_guard:change-me@127.0.0.1:3306/note_guard
ADMIN_EMAILS=cloudhu2000@gmail.com
# API server only: the dashboard is not deployed with this process.
CONTENT_CHECKER_API_HOST=127.0.0.1
CONTENT_CHECKER_API_PORT=5179
CONTENT_CHECKER_ALLOWED_ORIGINS=http://localhost:5178,http://127.0.0.1:5178
